{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ephun/tapHLE/blob/trunk/compatibility/schema-v1.json",
  "title": "tapHLE compatibility application record",
  "description": "Schema v1. Reports are immutable and append-only; dev-scripts/compatibility.py enforces that rule against a Git baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "slug",
    "title",
    "versions"
  ],
  "properties": {
    "$schema": {
      "const": "../schema-v1.json"
    },
    "schema_version": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/version"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "archive_org",
        "reports"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "archive_org": {
          "$ref": "#/$defs/archiveOrg"
        },
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/report"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_identifier",
        "bundle_version",
        "minimum_os_version"
      ],
      "properties": {
        "bundle_identifier": {
          "type": "string",
          "minLength": 1
        },
        "bundle_version": {
          "type": "string",
          "minLength": 1
        },
        "short_version": {
          "type": "string",
          "minLength": 1
        },
        "minimum_os_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "archiveOrg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "item_url",
        "bundle_identifier",
        "bundle_version",
        "files",
        "verification",
        "availability"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "item_url": {
          "type": "string",
          "pattern": "^https://archive\\.org/details/[A-Za-z0-9._-]+$"
        },
        "bundle_identifier": {
          "type": "string",
          "minLength": 1
        },
        "bundle_version": {
          "type": "string",
          "minLength": 1
        },
        "short_version": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/archiveFile"
          }
        },
        "verification": {
          "$ref": "#/$defs/archiveVerification"
        },
        "availability": {
          "$ref": "#/$defs/availability"
        }
      }
    },
    "archiveFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipa_filename",
        "md5",
        "sha1",
        "sha256",
        "tested"
      ],
      "properties": {
        "ipa_filename": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.[iI][pP][aA]$"
        },
        "md5": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tested": {
          "type": "boolean"
        }
      }
    },
    "archiveVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "checked_at",
        "notes"
      ],
      "properties": {
        "state": {
          "enum": [
            "content-hash-verified",
            "metadata-only",
            "unverified"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_at",
        "status",
        "notes"
      ],
      "properties": {
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": [
            "maintainer-designated-unavailable",
            "unavailable-no-current-store-alternative",
            "current-market-alternative",
            "unknown",
            "rightsholder-restricted"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tested_at",
        "taphle_commit",
        "host",
        "artifact",
        "status",
        "booted",
        "summary",
        "milestones",
        "blocker",
        "features"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
        },
        "tested_at": {
          "type": "string",
          "format": "date"
        },
        "taphle_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "artifact": {
          "$ref": "#/$defs/testedArtifact"
        },
        "status": {
          "enum": [
            "launch-blocked",
            "boots",
            "menu",
            "in-game",
            "playable-with-issues",
            "playable"
          ]
        },
        "booted": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocker": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "$ref": "#/$defs/features"
        },
        "supersedes": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "os_version",
        "architecture",
        "cpu",
        "gpu"
      ],
      "properties": {
        "os": {
          "const": "Windows"
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "gpu": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "testedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_ipa_filename",
        "sha1",
        "verification"
      ],
      "properties": {
        "archive_ipa_filename": {
          "type": "string",
          "minLength": 1
        },
        "sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "verification": {
          "const": "archive-content-hash"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphics",
        "audio",
        "input",
        "saving",
        "network"
      ],
      "properties": {
        "graphics": {
          "$ref": "#/$defs/featureState"
        },
        "audio": {
          "$ref": "#/$defs/featureState"
        },
        "input": {
          "$ref": "#/$defs/featureState"
        },
        "saving": {
          "$ref": "#/$defs/featureState"
        },
        "network": {
          "$ref": "#/$defs/featureState"
        }
      }
    },
    "featureState": {
      "enum": [
        "unknown",
        "broken",
        "partial",
        "working",
        "not-applicable"
      ]
    }
  }
}
